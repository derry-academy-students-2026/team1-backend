// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobRole {
  jobRoleId    Int        @id @default(autoincrement())
  roleName     String
  location     String
  closingDate  DateTime
  status       String
  capabilityId Int
  bandId       Int

  capability   Capability @relation(fields: [capabilityId], references: [capabilityId])
  band         Band       @relation(fields: [bandId], references: [bandId])

  @@map("job_roles")
}

model Capability {
  capabilityId   Int       @id @default(autoincrement())
  capabilityName String

  jobRoles       JobRole[]

  @@map("capabilities")
}

model Band {
  bandId   Int       @id @default(autoincrement())
  bandName String

  jobRoles JobRole[]

  @@map("bands")
}


