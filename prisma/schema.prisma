// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobRole {
  jobRoleId    Int        @id @default(autoincrement())
  roleName     String
  location     String
  closingDate  DateTime
  statusId     Int
  capabilityId Int
  bandId       Int
  description  String
  responsibilities String
  sharepointUrl String @unique
  numberOfOpenPositions Int

  capability   Capability @relation(fields: [capabilityId], references: [capabilityId])
  band         Band       @relation(fields: [bandId], references: [bandId])
  status       Status     @relation(fields: [statusId], references: [statusId])
  applications Application[]

  @@map("job_roles")
}

model Capability {
  capabilityId   Int       @id @default(autoincrement())
  capabilityName String    @unique

  jobRoles       JobRole[]

  @@map("capabilities")
}

model Band {
  bandId   Int       @id @default(autoincrement())
  bandName String    @unique

  jobRoles JobRole[]

  @@map("bands")
}

model Status {
  statusId   Int       @id @default(autoincrement())
  statusName String    @unique

  jobRoles   JobRole[]

  @@map("statuses")
}

model User {
  userId       Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())

  applications Application[]

  @@map("users")
}

model Application {
  applicationId  Int      @id @default(autoincrement())
  jobRoleId      Int
  userId         Int
  applicantName  String
  applicantEmail String
  phoneNumber    String
  address        String
  linkedInUrl    String?
  coverLetter    String
  status         String   @default("in progress")
  createdAt      DateTime @default(now())

  jobRole JobRole @relation(fields: [jobRoleId], references: [jobRoleId])
  user    User    @relation(fields: [userId], references: [userId])

  // One application per account per role, so a different typed email cannot bypass the check
  @@unique([jobRoleId, userId])
  @@map("applications")
}

