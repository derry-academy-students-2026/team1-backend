{
	"name": "team1-backend",
	"version": "1.0.0",
	"description": "Team1 Backend",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"vitest": {
		"environment": "node",
		"exclude": [
			"dist/**",
			"node_modules/**"
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/derry-academy-students-2026/team1-backend.git"
	},
	"keywords": [],
	"type": "module",
	"bugs": {
		"url": "https://github.com/derry-academy-students-2026/team1-backend/issues"
	},
	"homepage": "https://github.com/derry-academy-students-2026/team1-backend#readme",
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^6.19.3",
		"argon2": "^0.45.1",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.11.0",
		"pg": "^8.23.0",
		"winston": "^3.19.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.1.2",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"prisma": "^6.19.3",
		"supertest": "^7.2.2",
		"tsx": "^4.23.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"allowScripts": {
		"argon2@0.45.1": true
	}
}
