{
	"name": "team1-backend",
	"version": "1.0.0",
	"description": "Team1 Backend",
	"main": "index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"lint": "biome check src",
		"test": "npm run build && node --test dist/services/healthService.test.js",
